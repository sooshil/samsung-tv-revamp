# Copy to config/local.env (git-ignored) and edit. Nothing in this file is ever committed.
TV_IP=192.168.1.50                      # your TV's IP address (Settings > General > Network > Network Status)
TIZEN_SDK=$HOME/tizen-studio            # where Tizen Studio / the Tizen CLI is installed
SIGN_PROFILE=tv-revamp                  # name of your Tizen signing profile (see README step 4)
# MAC_IP=192.168.1.20                   # only for the optional on-TV self-tests; defaults to this computer's address
