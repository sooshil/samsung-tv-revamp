<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets"
        id="http://tvrevamp.local/dashboard" version="__VERSION__" viewmodes="maximized">
    <tizen:application id="tvrevamp00.Dashboard" package="tvrevamp00" required_version="6.0"/>
    <tizen:profile name="tv-samsung"/>
    <content src="index.html"/>
    <name>Home</name>
    <icon src="icon.png"/>
    <feature name="http://tizen.org/feature/screen.size.all"/>

    <tizen:privilege name="http://tizen.org/privilege/application.launch"/>
    <tizen:privilege name="http://tizen.org/privilege/application.info"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:privilege name="http://developer.samsung.com/privilege/productinfo"/>

    <!-- Verified on this TV: these two make the app resume in place after launching other apps. -->
    <tizen:metadata key="http://samsung.com/tv/metadata/multitasking.support" value="true"/>
    <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="enable"
                   encryption="disable" install-location="auto" hwkey-event="enable"/>

    <!-- The return watcher brings the dashboard back with an app control to itself; don't reload the page for it. -->
    <tizen:app-control>
        <tizen:src name="index.html" reload="disable"/>
        <tizen:operation name="http://tizen.org/appcontrol/operation/default"/>
    </tizen:app-control>

    <access origin="https://api.open-meteo.com" subdomains="false"/>
    <access origin="https://geocoding-api.open-meteo.com" subdomains="false"/>
    __DEV_ACCESS__
</widget>
